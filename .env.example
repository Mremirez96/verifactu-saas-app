# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.

# --- PostgreSQL: DOS credenciales distintas (ver lib/db/README.md) ---
# Rol de la APLICACIÓN: privilegios acotados (miembro de "verifactu_app").
# Lo crea `pnpm db:roles` a partir del usuario y la contraseña que pongas aquí.
POSTGRES_URL=postgresql://verifactu_app_login:***@host:5432/db
# Rol PROPIETARIO del esquema: solo para migraciones (drizzle-kit) y db:roles.
# No lo despliegues en el entorno de ejecución de la aplicación.
POSTGRES_MIGRATION_URL=postgresql://***

# --- VERI*FACTU ---
# Entorno de la AEAT para el QR y los envíos: pruebas | produccion.
# Obligatoria en producción (no hay valor por defecto).
VERIFACTU_AEAT_ENTORNO=pruebas
# Datos del PRODUCTOR del software para la declaración responsable
# (art. 15 Orden HAC/1177/2024). Sin ellos la declaración se muestra INCOMPLETA.
VERIFACTU_PRODUCTOR_NOMBRE=
VERIFACTU_PRODUCTOR_NIF=
VERIFACTU_PRODUCTOR_DIRECCION=
VERIFACTU_DECLARACION_FECHA=
VERIFACTU_DECLARACION_LUGAR=

STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
BASE_URL=http://localhost:3000
AUTH_SECRET=***
